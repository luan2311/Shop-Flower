@{
    ViewBag.Title = "Đăng ký tài khoản";
    Layout = "~/Views/Shared/_LayoutChung.cshtml";
}

<div class="bg-gray">
    <section class="section">
        <div class="container">
            <div class="page_register">
                <div class="row">
                    <div class="col-lg-4 col-md-6 col-sm-12 col-xl-4 offset-0 offset-xl-4 offset-lg-4 offset-md-3 col-12 account-animate">
                        <div class="page-register pagecustome clearfix">
                            <div class="wpx">
                                <h1 class="title_heads a-center"><span>Đăng ký</span></h1>

                                @using (Html.BeginForm("Dang_ky", "Account", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()

                                    <span class="form-signup text-danger">
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                    </span>

                                    <div class="form-signup clearfix">
                                        <fieldset class="form-group">
                                            <input type="text" name="TenDangNhap" class="form-control form-control-lg" placeholder="Tên đăng nhập" required />
                                        </fieldset>

                                        <fieldset class="form-group">
                                            <input type="email" name="Email" class="form-control form-control-lg" placeholder="Email" required />
                                        </fieldset>

                                        <fieldset class="form-group">
                                            <input type="text" name="TenHienThi" class="form-control form-control-lg" placeholder="Tên hiển thị (không bắt buộc)" />
                                        </fieldset>

                                        <fieldset class="form-group">
                                            <input type="password" name="MatKhau" class="form-control form-control-lg" placeholder="Mật khẩu" required />
                                        </fieldset>

                                        <fieldset class="form-group">
                                            <input type="password" name="XacNhanMatKhau" class="form-control form-control-lg" placeholder="Xác nhận mật khẩu" required />
                                        </fieldset>

                                        <div class="pull-xs-left">
                                            <input class="btn btn-primary btn-style" type="submit" value="ĐĂNG KÝ" />
                                        </div>

                                        <div class="btn_boz_khac" style="margin-top:10px;">
                                            <div class="btn_khac">
                                                <span>Đã có tài khoản?</span>
                                                <a href="@Url.Action("Dang_nhap", "Account")" class="btn-link-style btn-register" title="Đăng nhập">Đăng nhập</a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var form = document.querySelector('form');
            var usernameInput = document.getElementById('TenDangNhap');
            var emailInput = document.getElementById('Email');
            var passwordInput = document.getElementById('MatKhau');
            var confirmPasswordInput = document.getElementById('XacNhanMatKhau');

            // Trim spaces for username automatically
            if (usernameInput) {
                usernameInput.addEventListener('blur', function () {
                    this.value = this.value.trim();
                });
            }

            function showError(inputElement, fieldName, message) {
                if (inputElement) {
                    inputElement.classList.add('is-invalid');
                    inputElement.classList.remove('is-valid');
                }
                var span = document.querySelector("[data-valmsg-for='" + fieldName + "']");
                if (span) {
                    span.textContent = message;
                    span.style.display = 'block';
                }
                return false;
            }

            function clearError(inputElement, fieldName) {
                if (inputElement) {
                    inputElement.classList.remove('is-invalid');
                    inputElement.classList.add('is-valid');
                }
                var span = document.querySelector("[data-valmsg-for='" + fieldName + "']");
                if (span) {
                    span.textContent = '';
                    span.style.display = 'none';
                }
                return true;
            }

            function validateEmail() {
                if (!emailInput) return true;
                var val = emailInput.value.trim();
                if (!val) {
                    return showError(emailInput, 'Email', 'Vui lòng nhập Email.');
                }
                var emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                if (!emailRegex.test(val)) {
                    return showError(emailInput, 'Email', 'Email không hợp lệ (ví dụ: client@example.com)');
                }
                return clearError(emailInput, 'Email');
            }

            // Client side validation on blur & input
            if (emailInput) {
                emailInput.addEventListener('blur', validateEmail);
                emailInput.addEventListener('input', validateEmail);
            }

            function validatePassword() {
                if (!passwordInput) return true;
                var val = passwordInput.value;
                if (!val) {
                    return showError(passwordInput, 'MatKhau', 'Vui lòng nhập mật khẩu.');
                }
                if (val.length < 5) {
                    return showError(passwordInput, 'MatKhau', 'Mật khẩu phải từ 5 ký tự trở lên.');
                }
                return clearError(passwordInput, 'MatKhau');
            }

            if (passwordInput) {
                passwordInput.addEventListener('blur', validatePassword);
                passwordInput.addEventListener('input', validatePassword);
            }

            function validateConfirmPassword() {
                if (!confirmPasswordInput || !passwordInput) return true;
                var val = confirmPasswordInput.value;
                var pwd = passwordInput.value;
                if (val !== pwd) {
                    return showError(confirmPasswordInput, 'XacNhanMatKhau', 'Mật khẩu xác nhận không khớp.');
                }
                return clearError(confirmPasswordInput, 'XacNhanMatKhau');
            }

            if (confirmPasswordInput) {
                confirmPasswordInput.addEventListener('blur', validateConfirmPassword);
                confirmPasswordInput.addEventListener('input', validateConfirmPassword);
            }

            if (form) {
                form.addEventListener('submit', function (e) {
                    if (usernameInput) {
                        usernameInput.value = usernameInput.value.trim();
                    }
                    var isEmailValid = validateEmail();
                    var isPasswordValid = validatePassword();
                    var isConfirmValid = validateConfirmPassword();

                    if (!isEmailValid || !isPasswordValid || !isConfirmValid) {
                        e.preventDefault();
                    }
                });
            }
        });
    </script>
}