            <con:settings/>
            <con:endpoint>https://localhost:44357</con:endpoint>
            <con:request/>
            <con:assertion type="Valid HTTP Status Codes" name="Assert_Status_200" id="5cb340e4-b778-43d9-a292-0bca0b1c0bf1">
              <con:configuration>
                <codes>200</codes>
              </con:configuration>
            </con:assertion>
          </con:restRequest>
        </con:config>
      </con:testStep>
    </con:testCase>
